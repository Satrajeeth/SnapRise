# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Generate a plain secret with:   openssl rand -hex 32
# Generate the Fernet key with:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEBUG=True
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://snaprise_user:snaprise_password@postgres:5432/board_db
SYNC_DATABASE_URL=postgresql+psycopg2://snaprise_user:snaprise_password@postgres:5432/board_db
# ALLOWED_ORIGINS is a List[str]; if set, use JSON form e.g. ["http://localhost:3000"].
# Left unset here so it falls back to the ["*"] default.

# --- Secrets (required, no default) ---
# Fernet 32-byte url-safe base64 key. Encrypts sensitive board data.
ENCRYPTION_KEY=CHANGE_ME_fernet_generate_key
# MUST be identical to auth_service AUTH_JWT_SECRET (board verifies auth's access tokens).
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_AUDIENCE=fastapi-users:auth
# MUST match admin_service ADMIN_INGEST_SECRET.
ADMIN_INGEST_SECRET=CHANGE_ME_openssl_rand_hex_32
# MUST match otp_service EMAIL_SEND_SECRET.
EMAIL_SEND_SECRET=CHANGE_ME_openssl_rand_hex_32

# Invitations / cross-service URLs
FRONTEND_BASE_URL=http://localhost:3000
ADMIN_SERVICE_URL=http://admin_api:8000
OTP_SERVICE_URL=http://otp_api:8000
EMAIL_DELIVERY_MODE=console

# AI Configuration
DEFAULT_LLM_PROVIDER=local
OPENAI_API_KEY=
LOCAL_LLM_URL=http://localhost:1234/v1
DEFAULT_MODEL_NAME=gpt-4o-mini

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1