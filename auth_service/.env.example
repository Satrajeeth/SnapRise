DEBUG=True
APP_NAME=SnapRise Auth Service
AUTH_JWT_SECRET=super-secret-auth-key
ALLOWED_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://app:password@postgres:5432/auth_db

# Password reset delivery
RESET_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password
PASSWORD_RESET_DELIVERY_MODE=console

# SMTP (used when PASSWORD_RESET_DELIVERY_MODE=smtp)
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_FROM_EMAIL=no-reply@snaprise.local
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_SSL=False
