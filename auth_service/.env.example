# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Generate a secret with: openssl rand -hex 32
DEBUG=True
APP_NAME=SnapRise Auth Service
ALLOWED_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/auth_db

# --- Secrets (required, no default) ---
# JWT signing key. MUST be identical to admin_service JWT_SECRET and board_service JWT_SECRET.
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Verifies OTP proof tokens. MUST match otp_service OTP_PROOF_SECRET.
OTP_PROOF_SECRET=CHANGE_ME_openssl_rand_hex_32
# Gates the internal profile-lookup endpoint (presented by the frontend BFF).
PROFILE_LOOKUP_SECRET=CHANGE_ME_openssl_rand_hex_32

# Password reset delivery
RESET_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password
PASSWORD_RESET_DELIVERY_MODE=console

# SMTP (used when PASSWORD_RESET_DELIVERY_MODE=smtp)
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_FROM_EMAIL=no-reply@snaprise.local
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_SSL=False