# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Generate a secret with: openssl rand -hex 32
DEBUG=True
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://snaprise_user:snaprise_password@postgres:5432/admin_db
SYNC_DATABASE_URL=postgresql+psycopg2://snaprise_user:snaprise_password@postgres:5432/admin_db

# Comma-separated allowed CORS origins (the backoffice app).
ALLOWED_ORIGINS=http://localhost:3001

# --- Secrets (required, no default) ---
# MUST be identical to auth_service AUTH_JWT_SECRET so shared access tokens verify.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_AUDIENCE=fastapi-users:auth

# Protects POST /v1/internal/leads/ingest (board_service -> admin_service).
# MUST match board_service ADMIN_INGEST_SECRET.
ADMIN_INGEST_SECRET=CHANGE_ME_openssl_rand_hex_32