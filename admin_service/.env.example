DEBUG=True
DATABASE_URL=postgresql+asyncpg://snaprise_user:snaprise_password@postgres:5432/admin_db
SYNC_DATABASE_URL=postgresql+psycopg2://snaprise_user:snaprise_password@postgres:5432/admin_db

# Must match auth_service AUTH_JWT_SECRET so shared access tokens verify.
JWT_SECRET=super-secret-auth-key
JWT_ALGORITHM=HS256
JWT_AUDIENCE=fastapi-users:auth

# Shared secret protecting POST /v1/internal/leads/ingest (board_service -> admin_service).
ADMIN_INGEST_SECRET=super-secret-ingest-key

# Comma-separated allowed CORS origins (the backoffice app).
ALLOWED_ORIGINS=http://localhost:3001
