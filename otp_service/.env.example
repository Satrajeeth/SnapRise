# -------------------------
# APP
# -------------------------
DEBUG=True
OTP_SECRET_KEY=super-secret-key

# -------------------------
# DATABASE
# -------------------------
DATABASE_URL=postgresql+asyncpg://app:password@postgres:5432/otp_db

# -------------------------
# DATABASE (SYNC - Alembic)
# -------------------------
SYNC_DATABASE_URL=postgresql+psycopg2://app:password@postgres:5432/otp_db


# -------------------------
# REDIS
# -------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------
# CELERY
# -------------------------
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------
# SMTP
# Docker-to-Docker default: SMTP_HOST=smtp, SMTP_PORT=25
# If running the API on your Mac host instead, use localhost:2525
# -------------------------
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_FROM_EMAIL=no-reply@smtp.local
SMTP_TIMEOUT_SECONDS=10
