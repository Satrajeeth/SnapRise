# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Generate a secret with: openssl rand -hex 32
# -------------------------
# APP
# -------------------------
DEBUG=True
ENVIRONMENT=development

# -------------------------
# DATABASE
# -------------------------
DATABASE_URL=postgresql+asyncpg://app:password@postgres:5432/otp_db

# -------------------------
# DATABASE (SYNC - Alembic)
# -------------------------
SYNC_DATABASE_URL=postgresql+psycopg2://app:password@postgres:5432/otp_db

# -------------------------
# REDIS
# -------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------
# CELERY
# -------------------------
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------
# SECRETS (required, no default)
# -------------------------
# Signs OTP proof tokens. MUST match auth_service OTP_PROOF_SECRET.
OTP_PROOF_SECRET=CHANGE_ME_openssl_rand_hex_32
# Gates POST /v1/email/send (board_service presents it). MUST match board_service EMAIL_SEND_SECRET.
EMAIL_SEND_SECRET=CHANGE_ME_openssl_rand_hex_32

# -------------------------
# SMTP
# Configure your real SMTP relay here.
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_EMAIL=youraddress@gmail.com
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False
# -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FALLBACK_ENABLED=False