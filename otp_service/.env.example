# -------------------------
# APP
# -------------------------
DEBUG=True
OTP_SECRET_KEY=super-secret-key

# -------------------------
# DATABASE
# -------------------------
DATABASE_URL=postgresql+asyncpg://app:password@snaprise_postgres:5432/otp_db

# -------------------------
# DATABASE (SYNC - Alembic)
# -------------------------
SYNC_DATABASE_URL=postgresql+psycopg2://app:password@snaprise_postgres:5432/otp_db


# -------------------------
# REDIS
# -------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------
# CELERY
# -------------------------
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------
# SMTP
# Configure your real SMTP relay here.
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_EMAIL=youraddress@gmail.com
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False
# -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FALLBACK_ENABLED=False
