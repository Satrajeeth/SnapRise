{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
    "name": "SnapRise Auth & OTP Services",
    "description": "Postman collection for SnapRise Authentication and OTP microservices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "OTP Service",
      "item": [
        {
          "name": "1. Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"email_verification\",\n  \"tenant_id\": \"snaprise\"\n}"
            },
            "url": {
              "raw": "{{base_url_otp}}/v1/otp/send",
              "host": [
                "{{base_url_otp}}"
              ],
              "path": [
                "v1",
                "otp",
                "send"
              ]
            }
          }
        },
        {
          "name": "2. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.proof_token) {",
                  "    pm.environment.set(\"proof_token\", jsonData.proof_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"email_verification\",\n  \"code\": \"{{otp_code}}\",\n  \"tenant_id\": \"snaprise\"\n}"
            },
            "url": {
              "raw": "{{base_url_otp}}/v1/otp/verify",
              "host": [
                "{{base_url_otp}}"
              ],
              "path": [
                "v1",
                "otp",
                "verify"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Check Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_auth}}/auth/check-email?email={{email}}",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "check-email"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          }
        },
        {
          "name": "3. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_create\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"is_active\": true,\n    \"is_superuser\": false,\n    \"is_verified\": true\n  },\n  \"proof_token\": \"{{proof_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url_auth}}/auth/register",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "4. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url_auth}}/auth/jwt/login",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "jwt",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_auth}}/users/me",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"reset_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"proof_token\": \"{{proof_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url_auth}}/auth/forgot-password",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url_auth}}/auth/reset-password",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_auth}}/auth/jwt/logout",
              "host": [
                "{{base_url_auth}}"
              ],
              "path": [
                "auth",
                "jwt",
                "logout"
              ]
            }
          }
        }
      ]
    }
  ]
}
